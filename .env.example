# Bodita — Environment variables
# Copy to .env and fill in your values (never commit .env)
# Same variables work locally and on Vercel

# Firebase (required for RSVP form)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Zoom (optional — leave empty to hide virtual attendance section)
ZOOM_MEETING_URL=
ZOOM_MEETING_ID=
ZOOM_PASSWORD=
